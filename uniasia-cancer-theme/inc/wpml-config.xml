<wpml-config>
    <custom-fields>
        <custom-field action="translate">doctor_degree</custom-field>
        <custom-field action="translate">doctor_position</custom-field>
        <custom-field action="translate">doctor_hospital</custom-field>
        <custom-field action="translate">doctor_education</custom-field>
        <custom-field action="translate">doctor_specialties</custom-field>
        <custom-field action="translate">doctor_short_bio</custom-field>
