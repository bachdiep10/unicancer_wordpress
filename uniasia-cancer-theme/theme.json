{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "background": true,
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [
        {
          "name": "Primary Gradient",
          "slug": "primary-gradient",
          "gradient": "linear-gradient(135deg, #0066a4 0%, #004a7c 100%)"
        },
        {
          "name": "Hero Gradient",
          "slug": "hero-gradient",
          "gradient": "linear-gradient(135deg, rgba(0, 102, 164, 0.9) 0%, rgba(0, 60, 100, 0.85) 100%)"
        }
      ],
      "link": true,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#0066a4"
        },
        {
          "name": "Primary Dark",
          "slug": "primary-dark",
          "color": "#004a7c"
        },
        {
          "name": "Primary Light",
          "slug": "primary-light",
          "color": "#e6f2fa"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#00a3cc"
        },
        {
          "name": "Accent",
          "slug": "accent",
          "color": "#ff6b35"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#1a1a1a"
        },
        {
          "name": "Text Light",
          "slug": "text-light",
          "color": "#4a4a4a"
        },
        {
          "name": "Background",
          "slug": "background",
          "color": "#ffffff"
        },
        {
          "name": "Background Light",
          "slug": "background-light",
          "color": "#f7f9fc"
        },
        {
          "name": "Background Dark",
          "slug": "background-dark",
          "color": "#1a2332"
        }
      ],
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [ "px", "em", "rem", "vh", "vw", "%" ]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        },
        {
          "slug": "noto-sans",
          "name": "Noto Sans",
          "fontFamily": "'Noto Sans', sans-serif"
        },
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "14px",
          "fluid": false
        },
        {
          "slug": "medium",
          "size": "16px",
          "fluid": false
        },
        {
          "slug": "large",
          "size": "20px",
          "fluid": false
        },
        {
          "slug": "x-large",
          "size": "32px",
          "fluid": {
            "min": "24px",
            "max": "32px"
          }
        },
        {
          "slug": "xx-large",
          "size": "48px",
          "fluid": {
            "min": "32px",
            "max": "48px"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "h3": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "h4": {
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "section-hero",
      "title": "Hero Section",
      "area": "uncategorized"
    },
    {
      "name": "section-why-choose",
      "title": "Why Choose Us",
      "area": "uncategorized"
    },
    {
      "name": "section-mdt-team",
      "title": "MDT Team",
      "area": "uncategorized"
    },
    {
      "name": "section-cancer-types",
      "title": "Cancer Types",
      "area": "uncategorized"
    },
    {
      "name": "section-treatment-tech",
      "title": "Treatment Technology",
      "area": "uncategorized"
    },
    {
      "name": "section-patient-stories",
      "title": "Patient Stories",
      "area": "uncategorized"
    },
    {
      "name": "section-international-guide",
      "title": "International Guide",
      "area": "uncategorized"
    },
    {
      "name": "section-faqs",
      "title": "FAQs",
      "area": "uncategorized"
    },
    {
      "name": "section-contact-form",
      "title": "Contact Form",
      "area": "uncategorized"
    }
  ]
}